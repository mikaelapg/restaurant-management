# ==============================================================================
# Variáveis de Ambiente — Gestão de Restaurantes (Docker & Local)
# Copie este arquivo para .env se desejar customizar as variáveis no Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Credenciais e Nome do Banco de Dados PostgreSQL
POSTGRES_DB=restaurant_db
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_pass

# Porta exposta para a API Backend Spring Boot
SERVER_PORT=8080
