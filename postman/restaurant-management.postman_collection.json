        "{{base_url}}"
       ],
       "path": [
        "restaurant-owners"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Outro Dono\",\n  \"email\": \"{{owner_email}}\",\n  \"login\": \"outro.login.{{run_id}}\",\n  \"password\": \"Senha@123\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status 409\", function () {",
         "    pm.response.to.have.status(409);",
         "});",
         "",
         "pm.test(\"Corpo segue o formato ProblemDetail (RFC 7807)\", function () {",
         "    pm.response.to.have.header(\"Content-Type\");",
         "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
         "    const problem = pm.response.json();",
         "    pm.expect(problem).to.have.property(\"type\");",
         "    pm.expect(problem).to.have.property(\"title\");",
         "    pm.expect(problem).to.have.property(\"detail\");",
         "    pm.expect(problem.status).to.eql(409);",
         "    pm.expect(problem.title).to.include(\"E-mail\");",
         "});",
         "",
         "pm.test(\"A mensagem cita o e-mail recusado\", function () {",
         "    pm.expect(pm.response.json().detail).to.include(pm.collectionVariables.get(\"owner_email\"));",
         "});"
        ]
       }
      }
     ]
    },
