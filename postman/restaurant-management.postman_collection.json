         "pm.test(\"Corpo segue o formato ProblemDetail (RFC 7807)\", function () {",
         "    pm.response.to.have.header(\"Content-Type\");",
         "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
         "    const problem = pm.response.json();",
         "    pm.expect(problem).to.have.property(\"type\");",
         "    pm.expect(problem).to.have.property(\"title\");",
         "    pm.expect(problem).to.have.property(\"detail\");",
         "    pm.expect(problem.status).to.eql(400);",
         "    pm.expect(problem.title).to.include(\"Validação\");",
         "});",
         "",
         "pm.test(\"Aponta cada campo inválido\", function () {",
         "    const fieldErrors = pm.response.json().fieldErrors;",
         "    pm.expect(fieldErrors).to.be.an(\"object\");",
         "    pm.expect(fieldErrors).to.have.property(\"name\");",
         "    pm.expect(fieldErrors).to.have.property(\"email\");",
         "    pm.expect(fieldErrors).to.have.property(\"login\");",
         "    pm.expect(fieldErrors).to.have.property(\"password\");",
         "});"
        ]
       }
      }
     ]
    }
