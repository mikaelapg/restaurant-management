{
 "info": {
  "name": "Sistema de Gestão de Restaurantes — API v1",
  "description": "Coleção de testes da API de gestão de restaurantes.\n\nAs pastas estão na ordem em que devem rodar: cada uma depende do que a anterior cadastrou. Dá para rodar tudo de uma vez pelo Collection Runner ou pelo Newman.\n\nOs ids de dono e cliente são capturados dos próprios cadastros, e cada execução gera e-mails, logins, CPF e CNPJ diferentes — então a coleção pode rodar várias vezes no mesmo banco sem esbarrar nas restrições de unicidade.\n\nAntes de rodar, suba a aplicação com `docker compose up -d --build`.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "1. Cadastro de usuários",
   "item": [
    {
     "name": "Cadastrar dono de restaurante (201)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/restaurant-owners",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "restaurant-owners"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"{{owner_name}}\",\n  \"email\": \"{{owner_email}}\",\n  \"login\": \"{{owner_login}}\",\n  \"password\": \"Senha@123\",\n  \"restaurantName\": \"Restaurante do João\",\n  \"cnpj\": \"{{owner_cnpj}}\",\n  \"address\": {\n    \"street\": \"Av. Paulista\",\n    \"number\": \"1000\",\n    \"complement\": \"Conjunto 50\",\n    \"city\": \"São Paulo\",\n    \"state\": \"SP\",\n    \"zipCode\": \"01310-100\"\n  }\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "response": [],
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// Cada execução usa e-mails, logins, CPF e CNPJ próprios,",
         "// para que a coleção possa rodar mais de uma vez no mesmo banco.",
         "const runId = Date.now().toString().slice(-8);",
         "",
         "pm.collectionVariables.set(\"run_id\", runId);",
         "pm.collectionVariables.set(\"owner_name\", \"João Silva \" + runId);",
         "pm.collectionVariables.set(\"owner_email\", \"joao.silva.\" + runId + \"@restaurante.com\");",
         "pm.collectionVariables.set(\"owner_login\", \"joao.silva.\" + runId);",
         "pm.collectionVariables.set(\"owner_cnpj\", \"12.345.\" + runId.slice(0, 3) + \"/\" + runId.slice(3, 7) + \"-90\");",
         "pm.collectionVariables.set(\"customer_name\", \"Maria Oliveira \" + runId);",
         "pm.collectionVariables.set(\"customer_email\", \"maria.oliveira.\" + runId + \"@email.com\");",
         "pm.collectionVariables.set(\"customer_login\", \"maria.oliveira.\" + runId);",
         "pm.collectionVariables.set(\"customer_cpf\", runId.slice(0, 3) + \".\" + runId.slice(3, 6) + \".\" + runId.slice(6, 8) + \"1-00\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status 201 Created\", function () {",
         "    pm.response.to.have.status(201);",
         "});",
         "",
         "const owner = pm.response.json();",
         "",
         "pm.test(\"Devolve o dono cadastrado com id\", function () {",
         "    pm.expect(owner.id).to.be.a(\"number\");",
         "    pm.expect(owner.userType).to.eql(\"RESTAURANT_OWNER\");",
         "    pm.expect(owner.email).to.eql(pm.collectionVariables.get(\"owner_email\"));",
         "    pm.expect(owner.restaurantName).to.eql(\"Restaurante do João\");",
         "});",
         "",
         "pm.test(\"Registra a data da última alteração\", function () {",
         "    pm.expect(owner.lastModifiedAt).to.be.a(\"string\");",
         "});",
         "",
         "pm.test(\"Nunca devolve a senha\", function () {",
         "    pm.expect(owner).to.not.have.property(\"password\");",
         "});",
         "",
         "// Guarda o id para os próximos requests da coleção.",
         "pm.collectionVariables.set(\"owner_id\", owner.id);"
        ]
       }
      }
     ]
    },
    {
     "name": "Cadastrar cliente (201)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/customers",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "customers"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"{{customer_name}}\",\n  \"email\": \"{{customer_email}}\",\n  \"login\": \"{{customer_login}}\",\n  \"password\": \"Senha@456\",\n  \"cpf\": \"{{customer_cpf}}\",\n  \"dateOfBirth\": \"1995-07-15\",\n  \"address\": {\n    \"street\": \"Rua dos Jardins\",\n    \"number\": \"250\",\n    \"city\": \"Rio de Janeiro\",\n    \"state\": \"RJ\",\n    \"zipCode\": \"22041-011\"\n  }\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status 201 Created\", function () {",
         "    pm.response.to.have.status(201);",
         "});",
         "",
         "const customer = pm.response.json();",
         "",
         "pm.test(\"Devolve o cliente cadastrado com id\", function () {",
         "    pm.expect(customer.id).to.be.a(\"number\");",
         "    pm.expect(customer.userType).to.eql(\"CUSTOMER\");",
         "    pm.expect(customer.email).to.eql(pm.collectionVariables.get(\"customer_email\"));",
         "});",
         "",
         "pm.test(\"Grava o endereço enviado\", function () {",
         "    pm.expect(customer.address.city).to.eql(\"Rio de Janeiro\");",
         "});",
         "",
         "pm.test(\"Nunca devolve a senha\", function () {",
         "    pm.expect(customer).to.not.have.property(\"password\");",
         "});",
         "",
         "pm.collectionVariables.set(\"customer_id\", customer.id);"
        ]
       }
      }
     ]
    },
